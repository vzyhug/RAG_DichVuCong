LLM_PROVIDER=gemini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Required when LLM_PROVIDER=local. The endpoint must expose an
# OpenAI-compatible /v1 API, such as a local inference server.
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b-instruct

EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=3
CHUNK_SIZE=2500
CHUNK_OVERLAP=400
SIMILARITY_THRESHOLD=0.70
RESPONSE_MAX_TOKENS=768

FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_COLLECTION=chat_logs
ENABLE_FIREBASE_LOGGING=false
